{
  "version": 3,
  "name": "instagram_story_like",
  "notes": "Sample profile: like a story, then go to the next one. The two template images (the unliked heart and the next-story arrow) were captured on the author's screen, and the SEARCH BOXES ARE EMPTY on purpose, because they depend on your screen. To get started: (1) open the story viewer; (2) select each step and press 'Test this step' - if it says FOUND, a run would click; if it says NOT FOUND, press 'Capture template...' and drag around the icon on YOUR screen (the same drag then asks for the search box); (3) draw a 'search box' for every step - it makes scanning much faster and more reliable; (4) press 'Dry run', then 'Start'. F8, the red STOP button, or a screen corner stops it. Automated likes may violate Instagram's terms: keep the volume low, use the Speed slider and a click limit, and use it at your own risk.",
  "settings": {
    "loop_count": 10,
    "infinite_loop": true,
    "jitter_percent": 30.0,
    "max_total_clicks": 500,
    "stop_hotkey": "F8",
    "corner_abort": true,
    "scan_interval": 0.3,
    "start_delay": 2.0,
    "minimize_on_run": true,
    "max_idle_loops": 10,
    "monitor": 0,
    "auto_preset": true,
    "active_preset": "",
    "speed": 100,
    "speed_manual": false
  },
